<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3E78D8"/>
            <corners android:radius="12dp"/>
            <padding android:left="14dp" android:right="14dp" android:top="8dp" android:bottom="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4F8EF7"/>
            <corners android:radius="12dp"/>
            <padding android:left="14dp" android:right="14dp" android:top="8dp" android:bottom="8dp"/>
        </shape>
    </item>
</selector>
