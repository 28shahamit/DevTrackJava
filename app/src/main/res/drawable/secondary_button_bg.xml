<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#252B38"/>
            <stroke android:width="1dp" android:color="#3A4354"/>
            <corners android:radius="12dp"/>
            <padding android:left="14dp" android:right="14dp" android:top="8dp" android:bottom="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B202B"/>
            <stroke android:width="1dp" android:color="#303746"/>
            <corners android:radius="12dp"/>
            <padding android:left="14dp" android:right="14dp" android:top="8dp" android:bottom="8dp"/>
        </shape>
    </item>
</selector>
