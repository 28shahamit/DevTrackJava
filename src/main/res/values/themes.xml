<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- CR-002: dialogs use the same dark surface, border and accent color as the rest of the app
         instead of the default gray Material dialog surface. Applied via MainActivity.dlg(). -->
    <style name="AppTheme.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlNormal">@color/border</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textColorAlertDialogListItem">@color/text</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
